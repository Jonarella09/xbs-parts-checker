{
  "name": "The Indexer",
  "short_name": "Indexer",
  "description": "Count and index parts: projects, kits, photo counting, package labels and print plates.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1f5",
  "theme_color": "#14213d",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Indexer project",
      "accept": { "application/x-indexer-star": [".star"] },
      "icons": [{ "src": "icons/star-file-256.png", "sizes": "256x256", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
